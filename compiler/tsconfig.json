{
	"extends": "@tsconfig/strictest",
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "dist",
		"rootDir": "src",
		"types": [
			"node"
		],
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"strict": true,
		"declaration": true,
		"declarationDir": "./types",
		"stripInternal": true,
	},
	"include": [
		"./src/**/*"
	]
}