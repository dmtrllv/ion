{
	"name": "@ion/language-server-test",
	"displayName": "Ion Language Server Test",
	"version": "0.0.1",
	"private": true,
	"engines": {
		"vscode": "^1.90.0"
	},
	"main": "./dist/index.js",
	"type": "module",
	"activationEvents": [
		"onLanguage:typescript"
	],
	"contributes": {
		"languages": [
			{
				"id": "typescript",
				"extensions": [
					".ts"
				]
			}
		]
	},
	"scripts": {
		"build": "tsc",
		"test": "codium --new-window --extensionDevelopmentPath=\"$PWD\" \"$PWD/../../examples/signals-test\""
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@types/vscode": "^1.90.0",
		"typescript": "^5.5.0"
	}
}